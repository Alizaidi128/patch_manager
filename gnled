        private String getDataArray(ManData md, HttpServletRequest request,String payNature)
        {
            ServletContext application = request.getSession().getServletContext();
            StringBuffer sb_Query=new StringBuffer("select PSR_SRNO , PSR_SRV_CODE , PTX_CODE , PSR_STD_RATE , PSR_RED_RATE , PSR_ADJ_RATE  , PPY_CODE ")
                    .append(" FROM PR_GL_SR_SERVICESREGION WHERE PSR_SRV_CODE='")
                    .append(request.getSession().getAttribute("PSR_SRV_CODE")).append("' ")
                    .append(" AND PSR_SRNO = '").append(request.getSession().getAttribute("PSR_SRNO")).append("' ");
                    if(payNature == null || payNature.length() == 0){
                        sb_Query.append(" AND 1 = 2 ");
                    }else{
                        sb_Query.append(" and PPY_CODE='").append(payNature).append("' ");
                    }

            ResultSet rs = null;
            StringBuffer sb = new StringBuffer("prodArry = new Array(");
            try
            {
                rs = md.executeQuery(sb_Query.toString());
                int counter = 0;
                while(rs.next())
                {
                    if(counter>0)
                        sb.append(",");

                    sb.append("'")  //PSR_SRNO , PSR_SRV_CODE , PTX_CODE , PSR_STD_RATE , PSR_RED_RATE , PSR_ADJ_RATE
                            .append(rs.getString("PSR_SRNO"))
                            .append("~")
                            .append(rs.getString("PSR_SRV_CODE")==null?"":rs.getString("PSR_SRV_CODE"))
                            .append("~")
                            .append(rs.getString("PTX_CODE")==null?"":rs.getString("PTX_CODE"))
                            .append("~")
                            .append(rs.getString("PSR_STD_RATE")==null?"":rs.getString("PSR_STD_RATE"))
                            .append("~")
                            .append(rs.getString("PSR_RED_RATE")==null?"":rs.getString("PSR_RED_RATE"))
                            .append("~")
                            .append(rs.getString("PSR_ADJ_RATE")==null?"":rs.getString("PSR_ADJ_RATE"))
                            .append("~")
                            .append(rs.getString("PPY_CODE")==null?"":rs.getString("PPY_CODE"))
                            .append("'");
                    counter++;
                }
                sb.append(");");
            }
            catch(Exception e)
            {
                e.printStackTrace();
            }
            finally
            {
                md.closeResultSet(rs);
            }
            return sb.toString();
        }

        private Vector getRiskRegions(ManData md,HttpServletRequest request,String payNature)
        {

            HttpSession session = request.getSession();
            ServletContext application = session.getServletContext();

            StringBuffer sb_Query = new StringBuffer("select PTX_CODE , PTX_DESC from PR_GL_TR_TAXREGIONS WHERE ")
                .append(" PTX_TYPE = 'D' ");

                if(payNature == null || payNature.length() == 0){
                    sb_Query.append(" AND 1 = 2 ");
                }

                sb_Query.append(" ORDER BY PTX_DESC ");

            ResultSet rs = null;
            Vector v_RiskRegion=new Vector();
            try
            {
                rs = md.executeQuery(sb_Query.toString());
                while(rs.next())
                {
                    v_RiskRegion.add(rs.getString(1)+"~"+rs.getString(2));

                }
            }
            catch(Exception e)
            {
                e.printStackTrace();
            }
            finally
            {
                md.closeResultSet(rs);
            }
            return v_RiskRegion;
        }

