        private HashMap<String,String> getServicesSupplies()throws Exception{

            HashMap<String,String> hashMap = new HashMap<>();

            CentRecordSet centRecordSet = null;

            StringBuilder sb_Query = new StringBuilder();

            sb_Query.append(" SELECT PPY_CODE , PPY_DESC FROM PR_GC_PY_PAYMENT_NATURE WHERE PPY_CODE IN ( '001' , '002' , '999' ) ");

            centRecordSet  = new ManData().executeQueryForRowSet(sb_Query.toString());

            while(centRecordSet.next()){
                hashMap.put(centRecordSet.getString("PPY_CODE"),centRecordSet.getString("PPY_DESC"));
            }

            return  hashMap;
        }

