  function calculatePerilAmount(perilAmount,days,isLeapYear,id)
  {
		var roundAmount = 0;
	if(document.getElementById('GAC_SWPERIOD_TYPE_r_'+id)!=null)
	{
		var silentDays = silentPeriodDays.split('~')[0];
		var workingDays = silentPeriodDays.split('~')[1];
		if(document.getElementById('GAC_SWPERIOD_TYPE_r_'+id).value == 'SP')
		{
			if(silentDays.length>0)
			{
				roundAmount = perilAmount * silentWholeYear;
				days = silentNoOfDaysBalance;
				isLeapYear = silentIsLeapYear;
			}
				
		}
		else if(document.getElementById('GAC_SWPERIOD_TYPE_r_'+id).value == 'WP')
		{
			if(workingDays.length>0)
			{
				roundAmount = perilAmount * workingWholeYear;
				days = workingNoOfDaysBalance;
				isLeapYear = workingIsLeapYear;
			}
		}
	}
	else
	{
		roundAmount = perilAmount * wholeYear;
		days = noOfDaysBalance;
	}
	
    if(days == 0)
    	return roundAmount;

    if(isLeapYear)
    {
      if(<%=session.getAttribute("PDP_DEPT_CODE")!=null && (geninslib.policy.WebObjectsParser.isApplicationAttributeValid((String)session.getAttribute("PDP_DEPT_CODE"),"DEPTT_MISC",application))%>)
      {
        if(days==365)
          perilAmount = (perilAmount*days)/365;
        else
        {
          if(addOneDay() && days<366)
          	perilAmount = (perilAmount*(days+1))/366;
	  			else
          	perilAmount = (perilAmount*days)/366;
        }
      }
      else
      {

          if(addOneDay() && days<366)
          	perilAmount = (perilAmount*(days+1))/366;
          else
        	perilAmount = (perilAmount*days)/366;
       }
      return roundAmount + perilAmount;
    }
    else
    {
      if(<%=session.getAttribute("PDP_DEPT_CODE")!=null && (geninslib.policy.WebObjectsParser.isApplicationAttributeValid((String)session.getAttribute("PDP_DEPT_CODE"),"DEPTT_MISC",application))%>)
      {
        if(days==364)
          perilAmount = (perilAmount*days)/364;
        else
        {
          if(addOneDay() && days<365)
          {
          	perilAmount = (perilAmount*(days+1))/365;
          }
					else
					{
          	perilAmount = (perilAmount*days)/365;
          }
        }
      }
      else
      {
          if(addOneDay() && days<365)
          	perilAmount = (perilAmount*(days+1))/365;
	  else
        	perilAmount = (perilAmount*days)/365;
      }
      return roundAmount + perilAmount;
    }

  }

