 function revertFlatAmount(amt)
 {
	if(amt=='')
		return 0;
	amt = parseFloat(amt);
	ratio = 100*wholeYear;
	<%if(session.getAttribute("GDH_POLICYTYPE")!=null && ((String)session.getAttribute("GDH_POLICYTYPE")).equalsIgnoreCase("S")){ %>
		//return Math.round((amt/(<%=session.getAttribute("rateForShortPeriod")%>+ratio))*100);		// for rounding
		return round((amt/(<%=session.getAttribute("rateForShortPeriod")%>+ratio))*100,roundedPrecision);		// for rounding
		
		
	<%}else{ %>
		ratio = 365*wholeYear;	
		if(isLeapYear)
			//return Math.round(amt/(noOfDaysBalance+ratio)*366);
			return round(amt/(noOfDaysBalance+ratio)*366,roundedPrecision);
			
		else
			//return Math.round((amt/(noOfDaysBalance+ratio))*365);
			return round((amt/(noOfDaysBalance+ratio))*365,roundedPrecision);
			

	<%}%>
 }

